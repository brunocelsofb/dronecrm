// Vitrine do Varejo (landing das lojas do plano Loja) na Cloudflare Workers.
// Páginas estáticas em ./public; o Worker só atende /api/* e repassa ao Drone,
// dizendo de qual domínio a vitrine foi aberta (cada loja tem o seu).
{
  "name": "drone-vitrine",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // API pública do Drone (sem barra no fim)
    "DRONE_API": "https://app.comercialdrone.com.br/api/vitrine/v1"
  },
  "observability": { "enabled": true }
}
